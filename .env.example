# Copy to .env and fill in. Never commit .env.

# Nebius Token Factory (required for live runs)
NEBIUS_API_KEY=your-nebius-api-key
# NEBIUS_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1/

# Tavily web research (recommended)
TAVILY_API_KEY=your-tavily-api-key

# GitHub token with repo scope (optional: opens real pull requests)
GITHUB_TOKEN=

# Model ids (confirm with: leaply-guard models)
# MODEL_ULTRA=nvidia/Nemotron-3-Ultra-550b-a55b
# MODEL_SUPER=nvidia/nemotron-3-super-120b-a12b
# MODEL_NANO=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B

# Prices, USD per 1M tokens
# PRICE_ULTRA_IN=1.00
# PRICE_ULTRA_OUT=3.00
# PRICE_SUPER_IN=0.30
# PRICE_SUPER_OUT=0.90
# PRICE_NANO_IN=0.06
# PRICE_NANO_OUT=0.24

# Limits
# MAX_FIX_ITERATIONS=6
# SAME_ERROR_LIMIT=3
# MAX_DIFF_LINES=400
# LLM_TIMEOUT_SECONDS=180
# LLM_MAX_RETRIES=4

# Hosted demo: restrict live runs to the bundled demo repo and rate limit them
# LEAPLY_HOSTED=1
# LIVE_RUNS_PER_HOUR=3
# LIVE_RUNS_PER_DAY=40
